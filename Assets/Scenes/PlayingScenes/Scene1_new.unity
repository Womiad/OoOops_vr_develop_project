--- !u!114 &1234444640
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1234444634}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8413baf04b0bb6043a6c8ce3c3d9c016, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tMP_Text: {fileID: 446972652}
  buttons: {fileID: 379883522}
  slimeImage: {fileID: 641521614}
  slimeOpenEye: {fileID: 21300000, guid: 894643d8d59dec34087c33e341cc118a, type: 3}
  slimeCloseEye: {fileID: 21300000, guid: 1b23c4d4d93126a4785bb5a64c1567b8, type: 3}
  audioSource: {fileID: 1234444641}
  linesGuild:
  - text: Hi~ You're here!
    audio: {fileID: 8300000, guid: dcbad535f2df75443855f4d6176a1776, type: 3}
  - text: The squishy one giving you a ride today is my friend~
    audio: {fileID: 8300000, guid: db1f8e118b9b7f044a6dce917a9b081f, type: 3}
  - text: Once you hop on, give it a little push down...
    audio: {fileID: 8300000, guid: 36a312e3ac521e04a80bda33ff56da72, type: 3}
  - text: "And boing\u2014we'll bounce right up!"
    audio: {fileID: 8300000, guid: bd866c87f276f6948abcbc8bf8201fcd, type: 3}
  - text: "Oops, um\u2026 since our little slime brains are suuuper tiny\u2026 >w<"
    audio: {fileID: 8300000, guid: e5faef01976f38c4793d7e69278a654e, type: 3}
  - text: "it takes us a bit longer to react to your bounces\u2026 "
    audio: {fileID: 8300000, guid: db1f8e118b9b7f044a6dce917a9b081f, type: 3}
  - text: "But we\u2019ll still do our best to keep going! Thank you so much! >w<"
    audio: {fileID: 8300000, guid: 83388a295e0c14a4b9579bb8577b41c1, type: 3}
  - text: As for the rest, you can check it out while jumping around!
    audio: {fileID: 8300000, guid: e18548837cf5f3d4b973c39f8f59762d, type: 3}
  linesRun:
  - text: "One, two\u2014one, two, one, two!"
    audio: {fileID: 8300000, guid: d9035c5d404517d4aa0cb7ad829a75f8, type: 3}
  - text: "Boing, boing\u2014let's head forward together!"
    audio: {fileID: 8300000, guid: 3c6c8466c29c98846b13afbbe656aeb5, type: 3}
  - text: Nice view, right?\n I really like this place~
    audio: {fileID: 8300000, guid: 83388a295e0c14a4b9579bb8577b41c1, type: 3}
  - text: Once you get the hang of bouncing,\nwe'll be able to go lots more places!
    audio: {fileID: 8300000, guid: 92e71961d2b015e41a7ccefbd9dfbc94, type: 3}
  question:
    text: Looks like you're getting the hang of it!\nWant to go check out some other
      places together?
    audio: {fileID: 8300000, guid: 16e1b3edeee19d24cb4e5b194cb450e4, type: 3}
  interval: 5
  askInterval: 30
